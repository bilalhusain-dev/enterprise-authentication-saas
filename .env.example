# ============================================================================
# ENTERPRISE AUTHENTICATION SAAS (EA SAAS) - ENVIRONMENT VARIABLES
# ============================================================================

# 1. APPLICATION & DOMAIN CONFIGURATION
NEXT_PUBLIC_APP_NAME="Enterprise Authentication SaaS"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# 2. DATABASE CONFIGURATION (PostgreSQL / Supabase / Neon / Local Docker)
# Leave empty or omitted for zero-config hot in-memory store in development.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ea_saas?schema=public"

# 3. CRYPTOGRAPHIC KEYS & JWT SECRETS
# Generate with: openssl rand -base64 32
JWT_SECRET="ea_saas_enterprise_crypto_secret_key_9f82194a820c74b291848bc1029"
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=604800

# 4. SAML 2.0 / ENTERPRISE SSO PROVIDERS (Optional)
OKTA_CLIENT_ID="okta_client_id_here"
OKTA_CLIENT_SECRET="okta_client_secret_here"
OKTA_ISSUER="https://your-domain.okta.com/oauth2/default"

AZURE_AD_CLIENT_ID="azure_client_id_here"
AZURE_AD_CLIENT_SECRET="azure_client_secret_here"
AZURE_AD_TENANT_ID="azure_tenant_id_here"

# 5. WEBHOOK & EVENT DISPATCHING
WEBHOOK_SIGNING_SECRET="whsec_9f82194a820c74b291848bc1029"
